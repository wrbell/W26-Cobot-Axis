# Collection .gitattributes template (standards/templates/gitattributes).
# Base: F26/SD/.gitattributes. Copy it to the repository root, then see
# README.md in this folder before you renormalize an existing repo.

# Git decides text or binary; text is stored with LF.
* text=auto

# Source and text files are checked out with LF on every OS.
.gitattributes text eol=lf
.gitignore text eol=lf
Makefile text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.m text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.txt text eol=lf
*.csv text eol=lf

# Office files, PDFs and images are binary: no diff, no merge, no EOL.
*.xlsx binary
*.pptx binary
*.docx binary
*.potx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

