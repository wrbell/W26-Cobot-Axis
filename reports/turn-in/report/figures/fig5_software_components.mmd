%% Figure 5 — Software Component Diagram
%% src/bridge/ modules + Klipper host + MCU firmware

flowchart TB
    subgraph UR["URScript (UR30 teach pendant)"]
        URS["extrusion_control.script<br/>+ test_basic.script"]
    end

    subgraph BD["Bridge daemon — src/bridge/ (Python 3, 11 modules, 479 tests)"]
        direction TB
        CFG["config.py<br/>(register maps, constants)"]
        RTDE_C["rtde_client.py<br/>(ur-rtde wrapper)"]
        KLIP["klipper_client.py<br/>(Unix socket JSON-RPC)"]
        LOOP["bridge_daemon.py<br/>(125 Hz state machine)"]
        WD["watchdog.py<br/>(500 ms RTDE timeout)"]
        STAT["klipper_status.py<br/>(TMC2209 poll, 20 Hz)"]
        PROF["extrusion_profile.py<br/>(linear / poly / LUT)"]
        LOG["data_logger.py<br/>(CSV telemetry)"]
        ACC["stallguard_accumulator.py<br/>(event buffer + CSV)"]
        DASH["dashboard_client.py<br/>(UR Dashboard port 29999)"]
        RTDE_C --> LOOP
        KLIP --> LOOP
        PROF --> LOOP
        WD --> LOOP
        STAT --> LOOP
        ACC --> LOOP
        LOOP --> LOG
        DASH --> LOOP
        CFG -.-> LOOP
    end

    subgraph HOST["Klipper host (klippy)"]
        KGCODE["G-code interpreter<br/>+ motion planner<br/>+ 100 ms lookahead"]
    end

    subgraph MCU["Klipper firmware on SKR Pico (RP2040)"]
        MCODE["Step timing,<br/>TMC2209 UART driver"]
