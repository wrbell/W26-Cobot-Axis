# W26 Cobot Axis — Motor-Only Bringup Test (test_motor_only.script)
# Runs on: UR30 teach pendant / controller
# Purpose: Exercise the full command path (URScript -> RTDE -> Pi bridge ->
#          Klipper -> TMC2209 -> pump stepper) WITHOUT moving the robot arm.
#          Use this to verify motor control end-to-end on the bench.
#
# Validated end-to-end on 2026-04-22: pump motor visibly spinning under
# UR30 control via this script.
#
# Prerequisites:
#   - UR30 on 192.168.0.3, controller initialized (RUNNING / NORMAL)
#   - Pi on 192.168.0.4 (only .4 is whitelisted in UR30 inbound firewall)
#   - w26-bridge.service active on the Pi (RTDE + klippy both connected)
#   - SKR Pico flashed with Klipper; klipper.service shows MCU configured
#   - SKR Pico 24V VIN connected (TMC2209 needs motor voltage to respond)
#   - Klipper not in "halted" state and motion queue not full (a fresh
#     `FIRMWARE_RESTART` between long test runs prevents queue stalls)
#
# Register mapping (see docs/register_allocation.md):
#   output_int_register_12    = extrusion mode (0=off, 1=extrude, 2=retract)
#   output_double_register_12 = commanded extrusion rate (mm/s)
#   output_double_register_13 = TCP speed magnitude (mm/s) — held at 0.0
#
# Indices 12/13 (not 0/1) because ur-rtde enforces [12, 19] for int/double
# register access (0-11 are reserved for URCaps / Installation).
#
# Output bit registers 64-66 (enable / estop / home) are NOT read by the
# bridge — ur_rtde's RTDEReceiveInterface in this version doesn't expose
# getOutputBitRegister(). Motion is gated on `mode != 0` plus the bridge
# watchdog and pendant E-stop.
#
# IMPORTANT — script structure for Secondary Interface (port 30002):
#   Constants and helper logic must live INSIDE the def block. Top-level
#   variable assignments (`X = 5` outside any def) are silently rejected
#   by the controller when the script is pushed over Secondary Interface;
#   the script appears to upload but never runs. Keep everything inside
#   `motor_only_test()` and end the file with the call.
#
# Safety notes:
#   - This script does NOT call movel / movej / speedl / speedj. The arm
#     must not move at any point while this script runs.
#   - If the stepper motor does anything unexpected (stall, reversal,
#     thermal shutdown, screaming noise), hit the pendant E-stop.
#   - Bridge watchdog will halt the stepper within 500 ms of losing RTDE.
#   - Keep the speed slider above 0% on the teach pendant.

def motor_only_test():
    popup("Motor-only test running. Arm will NOT move.", title="W26", blocking=False)

    # Idle TCP speed register (we are not moving the arm).
    write_output_float_register(13, 0.0)

    # Engage: mode=extrude, rate still 0. Bridge will see mode != 0 and
    # start streaming MANUAL_STEPPER moves to klipper at the commanded rate.
    write_output_integer_register(12, 1)
    write_output_float_register(12, 0.0)
    sleep(0.5)

    # Ramp 0 -> 4.0 mm/s over 2.0 s (20 steps x 0.1 s).
    # Use float math (i / 20.0, not i / 20) so URScript doesn't truncate.
    local i = 1
    while i <= 20:
        local rate = 4.0 * (i / 20.0)
        write_output_float_register(12, rate)
        sleep(0.1)
        i = i + 1
    end

    # Hold at 4.0 mm/s (~6 rpm at rotation_distance=40 mm/rev — visible).
    write_output_float_register(12, 4.0)
    sleep(5.0)

    # Disengage cleanly: rate to 0, mode to off.
    write_output_float_register(12, 0.0)
    write_output_integer_register(12, 0)
    sleep(0.5)

    popup("Motor-only test complete.", title="W26", blocking=False)
end

motor_only_test()
