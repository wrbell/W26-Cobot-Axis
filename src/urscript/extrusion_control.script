# W26 Cobot Axis — URScript Extrusion Control Program
# Runs on: UR30 teach pendant / controller
# Purpose: Writes extrusion commands to RTDE output registers,
#          reads stepper status from RTDE input registers.
#
# Register mapping (from docs/register_allocation.md, post-PR #29):
#
# OUTPUT (UR30 → Pi, written here):
#   output_int_register_12    = extrusion mode (0=off, 1=extrude, 2=retract)
#   output_double_register_12 = commanded extrusion rate (mm/s)
#   output_double_register_13 = TCP speed magnitude (mm/s)
#
# INPUT (Pi → UR30, read here):
#   input_int_register_18     = stepper status (0=idle, 1=running, 2=error, 3=homing)
#   input_int_register_19     = error code (0=none, 1=comms_lost, 2=stall, 3=thermal)
#   input_double_register_18  = actual extrusion rate (mm/s)
#   input_double_register_19  = StallGuard load value (0-255, lower = higher load)
#
# ur-rtde Python binding restricts int/double register indices to
# [12, 19] for outputs and [18, 22] for inputs; bit registers are not
# exposed on either side. This script therefore uses int / double
# registers only. The bridge ignores bit-register writes, so they have
# been dropped entirely; motion is gated on `mode != 0` plus the bridge
# watchdog and pendant E-stop. Faults surface via input_int_register_18
# (status == 2 means ERROR) and input_int_register_19 (error code).
#
# IMPORTANT — Secondary Interface push:
#   When pushing this file via port 30002 (Secondary Interface), the
#   UR30 silently drops top-level variable assignments (e.g., a bare
#   `X = 5`). Either load this as a .urp on the pendant, or call the
#   desired top-level function from inside a `def ... end` wrapper.

# ===================================================================
# Configuration — adjust these for your application
# ===================================================================
MAX_EXTRUSION_RATE = 50.0     # mm/s safety limit (clamp in URScript + config.py)

# Speed-sync configuration (used by extrude_along_path only)
EXTRUSION_MULTIPLIER = 1.0    # mm extruded per mm/s TCP speed
ENABLE_SPEED_SYNC = True      # True = extrusion rate tracks TCP speed

# Status / error constants (mirror src/bridge/config.py)
STATUS_IDLE    = 0
STATUS_RUNNING = 1
STATUS_ERROR   = 2
STATUS_HOMING  = 3

# ===================================================================
# Helper functions — output registers
# ===================================================================

def set_extrusion_mode(mode):
    # mode: 0=off, 1=extrude, 2=retract
    write_output_integer_register(12, mode)
end

def set_extrusion_rate(rate_mm_s):
    # Clamp to safety limit (bridge also clamps — belt-and-braces)
    local clamped = rate_mm_s
    if clamped > MAX_EXTRUSION_RATE:
        clamped = MAX_EXTRUSION_RATE
    end
    write_output_float_register(12, clamped)
end

def update_tcp_speed():
    # Write current TCP speed to output register for the bridge daemon.
    local speed_vec = get_actual_tcp_speed()
    local speed_mag = norm(speed_vec)
    local speed_mm_s = speed_mag * 1000.0
    write_output_float_register(13, speed_mm_s)
    return speed_mm_s
end

# ===================================================================
# Helper functions — input registers (status from Pi)
# ===================================================================

def get_stepper_status():
    # 0=idle, 1=running, 2=error, 3=homing
    return read_input_integer_register(18)
end

def get_stepper_error():
    # 0=none, 1=comms_lost, 2=stall, 3=thermal
    return read_input_integer_register(19)
end

def get_actual_extrusion_rate():
    return read_input_float_register(18)
end

def get_stallguard_load():
    # StallGuard load value (0-255). Lower = higher motor load. 0 = stall.
    return read_input_float_register(19)
end

def is_stepper_ready():
    # "Ready" = not in error/homing. Idle or running is fine.
    local s = get_stepper_status()
    return s == STATUS_IDLE or s == STATUS_RUNNING
end

def is_stepper_fault():
    # Bridge sets status to ERROR whenever it asserts a fault condition.
    return get_stepper_status() == STATUS_ERROR
end

def check_stallguard():
    # Returns: -1 = stall, 0 = warning, 1 = ok
    local sg = get_stallguard_load()
    if sg < 10:
        return -1
    elif sg < 30:
        return 0
    else:
        return 1
    end
end

def wait_for_stepper_ready(timeout_s):
    local t0 = 0.0
    while is_stepper_ready() == False:
        sync()
        t0 = t0 + get_steptime()
        if t0 > timeout_s:
            popup("Stepper not ready — timeout", error=True)
            return False
        end
    end
    return True
end

# ===================================================================
# Initialize — clear command registers to a safe baseline
# ===================================================================

def init_registers():
    set_extrusion_mode(0)
    set_extrusion_rate(0.0)
    write_output_float_register(13, 0.0)    # TCP speed = 0 (arm idle)
end

# ===================================================================
# Constant-rate extrusion control (primary API)
# ===================================================================
# These two functions are the main interface for slicer-generated
# toolpaths. The pump runs at a fixed rate while the robot executes
# a sequence of moves, then shuts off at the end.
#
# Usage pattern:
#   init_registers()
#   pump_on(RATE)
#   mv(waypoint_1)    # slicer-generated moves
#   mv(waypoint_2)
#   ...
#   pump_off()
#   retract(2.0, 10.0)
#   init_registers()

def pump_on(rate_mm_s):
    # Start constant-rate extrusion. Call once before a sequence of
    # robot moves. Blocks until the stepper is ready (5s timeout).
    set_extrusion_mode(1)      # extrude — bridge gates on mode != 0
    set_extrusion_rate(rate_mm_s)

    if wait_for_stepper_ready(5.0) == False:
        set_extrusion_mode(0)
        popup("pump_on: stepper not ready", error=True)
    end
end

def pump_off():
    # Stop extrusion. Call after all robot moves are complete.
    # Does NOT retract — call retract() separately if needed.
    set_extrusion_mode(0)
    set_extrusion_rate(0.0)
end

def retract(distance_mm, speed_mm_s):
    # Brief retraction to relieve pressure (anti-ooze)
    set_extrusion_mode(2)      # retract
    set_extrusion_rate(speed_mm_s)

    # Wait for the retraction to complete (approximate timing)
    local retract_time = distance_mm / speed_mm_s
    sleep(retract_time)

    set_extrusion_mode(0)
    set_extrusion_rate(0.0)
end

# ===================================================================
# Advanced: Speed-synchronized extrusion
# ===================================================================
# Use extrude_along_path() when the extrusion rate must track TCP
# speed in real time (e.g., variable-speed paths where bead width
# must stay constant). For constant-velocity slicer output, prefer
# pump_on/pump_off above.

def extrude_along_path(target_pose, speed, accel):
    set_extrusion_mode(1)      # extrude

    # Wait for stepper to be ready (5 second timeout)
    if wait_for_stepper_ready(5.0) == False:
        set_extrusion_mode(0)
        return
    end

    # Start robot motion
    movel(target_pose, a=accel, v=speed)

    # Synchronize extrusion with robot speed
    while is_steady() == False:
        local tcp_speed = update_tcp_speed()

        if ENABLE_SPEED_SYNC:
            local rate = tcp_speed * EXTRUSION_MULTIPLIER
            set_extrusion_rate(rate)
        end

        # Check for stepper faults (including StallGuard-derived stalls)
        if is_stepper_fault():
            local err = get_stepper_error()
            local sg_status = check_stallguard()
            if sg_status == -1:
                popup("Pump stall detected (StallGuard)", error=True)
            else:
                popup(str_cat("Stepper fault: error code ", err), error=True)
            end
            stopl(2.0)         # decelerate robot to stop
            break
        end

        sync()
    end

    # Stop extrusion
    set_extrusion_mode(0)
    set_extrusion_rate(0.0)
end

# ===================================================================
# Example: wrapping slicer output with pump control
# ===================================================================
# The slicer generates a sequence of mv() calls at constant velocity.
# To add extrusion, wrap the slicer output with pump_on/pump_off:
#
#   def mv(pose):
#       movel(pose, a=1.2, v=0.06)
#   end
#
#   init_registers()
#
#   # Move to first waypoint without extruding
#   movej(start_joint_config, a=1.2, v=0.06)
#
#   # Start pump, run slicer path, stop pump
#   pump_on(10.0)           # 10 mm/s constant rate — tune via calibration
#   mv(waypoint_1)
#   mv(waypoint_2)
#   # ... (slicer-generated mv() calls) ...
#   mv(waypoint_N)
#   pump_off()
#
#   # Retract to relieve nozzle pressure
#   retract(2.0, 10.0)
#
#   # Cleanup
#   init_registers()
